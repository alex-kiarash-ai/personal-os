# GENERATED by scripts/lib/gen-systemd.js from scheduler/schedule.md. Do not hand-edit.
# Edit scheduler/schedule.md, then run: node scripts/generate-alex.js
[Unit]
Description=Alex: Sprint Tracker (timer)

[Timer]
OnCalendar=Mon..Fri 09:00:00
# Persistent=true is the StartWhenAvailable equivalent, and better: a job missed because the machine
# was off fires on the next boot instead of being lost.
Persistent=true
WakeSystem=true
# These jobs are time-anchored (the 07:30 sweep must land before the 08:00 brief reads it), so no
# randomized spread.
RandomizedDelaySec=0
AccuracySec=1min
Unit=PersonalOS-sprint-tracker.service

[Install]
WantedBy=timers.target
