# Line-ending policy (bash migration Phase 1, 2026-08-05).
#
# WHY THIS FILE EXISTS: a shell script with CRLF line endings fails at the shebang with a
# baffling "bad interpreter: /usr/bin/env bash^M" error. On a repo that is edited from macOS,
# Linux and (during the migration) Windows, that is not hypothetical. Normalizing here means
# the working tree is always LF for anything executable, regardless of who checked it out.

# Default: let git decide what is text, and store text as LF in the repo.
* text=auto

# Executables and config that MUST be LF in the working tree, always.
*.sh      text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.py      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.service text eol=lf
*.timer   text eol=lf

# Phase 9 (2026-08-18) deleted every migrated .ps1/.cmd file. work/voice/talk.ps1 + the 3
# work/voice/v3/*.cmd files are the deliberate exception: PARKED, not ported (ruling D,
# 2026-08-05 - Windows SAPI TTS has no Linux equivalent yet), so they still need CRLF handling.
# Delete these two lines only once voice is fully ported or retired.
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary: never touch these.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.xlsx    binary
*.docx    binary
*.pptx    binary
*.gpg     binary
*.db      binary
*.sqlite  binary
*.sqlite3 binary
*.woff    binary
*.woff2   binary
