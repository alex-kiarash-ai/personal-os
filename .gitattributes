# Line-ending policy (bash migration Phase 1, 2026-08-05).
#
# WHY THIS FILE EXISTS: a shell script with CRLF line endings fails at the shebang with a
# baffling "bad interpreter: /usr/bin/env bash^M" error. On a repo that is edited from macOS,
# Linux and (during the migration) Windows, that is not hypothetical. Normalizing here means
# the working tree is always LF for anything executable, regardless of who checked it out.

# Default: let git decide what is text, and store text as LF in the repo.
* text=auto

# Executables and config that MUST be LF in the working tree, always.
*.sh      text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.py      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.service text eol=lf
*.timer   text eol=lf

# PowerShell stays CRLF until the .ps1 files are deleted in Phase 9.
# Remove this line at that point (it is a Phase 9 checklist item).
*.ps1     text eol=crlf

# Windows-era batch files, likewise removed in Phase 9.
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary: never touch these.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.xlsx    binary
*.docx    binary
*.pptx    binary
*.gpg     binary
*.db      binary
*.sqlite  binary
*.sqlite3 binary
*.woff    binary
*.woff2   binary
