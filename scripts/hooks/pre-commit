#!/bin/sh
# pre-commit - the permanent validation gate (refactor P3-S3, decision D7).
# Runs scripts/validate-alex.js (the full suite; the validator declares its own range) on every commit;
# a red check blocks the commit.
# Two content scans run FIRST, both scoped to the STAGED content, both fail-closed on a finding:
#   - gitleaks (F3, 2026-07-25)            -> SECRETS
#   - personal-data-scan --staged (F-03)   -> PERSONAL DATA (names, kr/SEK, health, phone, secret paths)
# Together they are the PREVENT layer for the public repo; the monthly security sweep (S1 + S9) is the
# level-triggered backstop, and GitHub push protection is the server-side one.
# V10 (protected-file guard, 2026-07-15) reads the staged changeset via --changed and enforces
# vault/me/NEVER-TOUCH.md (immutable / append-only / flagged); override with git commit --no-verify.
# V11 (forced-add guard, 2026-07-17) blocks committing a `git add -f`'d gitignored path - the public
# repo's sole privacy barrier is .gitignore, so a forced-added secret is caught here before the push.
# V12 (trifecta gate, 2026-07-17) enforces the Rule-of-Two: an all-three-legs project must declare a
# gate in the manifest that is echoed in its work/NN/CLAUDE.md (runs every invocation, not just commit).
#
# Install (one-time per clone; this file is versioned, .git/hooks is not):
#   git config core.hooksPath scripts/hooks
#
# Credential design (P3-S3, option (a) + network carve-out, architect-flagged):
#   - V6 needs N8N_API_URL/N8N_API_KEY. If they are not in the environment, this wrapper loads the
#     key from the LOCAL key file (work/03-application-engine/config/n8n-api-key.txt, gitignored)
#     so V6 runs for REAL at commit time - including the nightly 21:30 headless git-backup job.
#     The credential itself never appears in code or in a committed file; this is a path, not a key.
#   - In --context=pre-commit the validator degrades V6 (n8n unreachable / no creds) and the live
#     half of V2 (no schtasks) to a LOUD WARNING SKIP instead of a failure, so a network outage or
#     a vault-less clone on another machine can never block a commit - and, critically, can never
#     block the nightly backup. A REAL mismatch (doc drift, job drift, rule model != live model)
#     still blocks. Full strictness lives in the generator context, which every generate-alex.js
#     run uses.
#   - Non-interactive and cheap by design: one node process, one schtasks query, at most two HTTP
#     GETs with a 15s timeout. Works under Windows Task Scheduler with no profile and no user env
#     vars (node is machine-scope; explicit fallback below).
#
# Escape hatch: git's standard `--no-verify` (deliberate, logged-by-you decision - no custom flag).

ROOT="$(git rev-parse --show-toplevel)" || exit 1

# --- F3 (2026-07-25 stress-test fix): content secret scan on the STAGED diff, BEFORE the node gate.
#     PREVENT layer - a secret blocked here never enters history. Backstops: security-sweep S1
#     (monthly full-history) + GitHub push protection (server-side, the guard a local hook cannot be).
#     gitleaks 8.30.1 is installed (winget); .gitleaks.toml carries the reviewed allowlist.
#     Fail policy (deliberate): a FOUND secret (exit 9) or a gitleaks that RUNS and errors BLOCKS
#     (fail-closed on the result). gitleaks ABSENT => loud WARN + PROCEED (fail-OPEN), so a PATH/
#     machine without gitleaks - including the nightly Task Scheduler backup - is never wedged; the
#     monthly S1 + push protection are the guarantees. (Unlike the node gate below, which fails
#     CLOSED because node is machine-scope and truly always present; gitleaks is user-scope.)
GITLEAKS=""
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS="gitleaks"
else
  GL="$(ls /c/Users/*/AppData/Local/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe 2>/dev/null | head -n1)"
  [ -x "$GL" ] && GITLEAKS="$GL"
fi
if [ -n "$GITLEAKS" ]; then
  "$GITLEAKS" git --staged --no-banner --redact --config "$ROOT/.gitleaks.toml" --exit-code 9 "$ROOT"
  GLS=$?
  if [ "$GLS" -eq 9 ]; then
    echo "pre-commit: BLOCKED - gitleaks found a secret in the STAGED content (redacted above)." >&2
    echo "pre-commit: remove it, or add a reviewed allowlist entry to .gitleaks.toml. PUBLIC repo: a pushed secret must be ROTATED, not just deleted." >&2
    exit 1
  elif [ "$GLS" -ne 0 ]; then
    echo "pre-commit: BLOCKED - gitleaks ran but errored (exit $GLS); fail-closed (cannot certify the commit is secret-free)." >&2
    echo "pre-commit: fix gitleaks/.gitleaks.toml, or 'git commit --no-verify' to override deliberately." >&2
    exit 1
  fi
  echo "pre-commit: gitleaks staged scan clean."
else
  echo "pre-commit: WARNING - gitleaks not found; STAGED secret scan SKIPPED (fail-open). Monthly S1 + GitHub push protection remain the backstops. Install: winget install Gitleaks.Gitleaks" >&2
fi

# Locate node: PATH first, then the machine-scope install location.
if command -v node >/dev/null 2>&1; then
  NODE=node
elif [ -x "/c/Program Files/nodejs/node.exe" ]; then
  NODE="/c/Program Files/nodejs/node.exe"
elif [ -x "/c/Program Files/nodejs/node" ]; then
  NODE="/c/Program Files/nodejs/node"
else
  echo "pre-commit: BLOCKED - node not found; validate-alex CANNOT run, so this commit is not validated." >&2
  echo "pre-commit: (BUG-07 fix 2026-07-15: fail CLOSED. A commit that cannot be validated must not pass" >&2
  echo "pre-commit:  the gate silently. node is machine-scope on this box; if it is genuinely gone the" >&2
  echo "pre-commit:  nightly backup blocks LOUD (RED HQ push) instead of committing ungated.)" >&2
  echo "pre-commit: Fix PATH / install Node.js, or 'git commit --no-verify' to override deliberately." >&2
  exit 1
fi

# Load n8n creds from the local key file when the environment does not carry them (option (a)).
KEY_FILE="$ROOT/work/03-application-engine/config/n8n-api-key.txt"
if [ -z "$N8N_API_KEY" ] && [ -f "$KEY_FILE" ]; then
  N8N_API_KEY="$(tr -d '\r\n' < "$KEY_FILE")"
  export N8N_API_KEY
fi
if [ -z "$N8N_API_URL" ]; then
  N8N_API_URL="https://n8n.shaheenkiarash.com/api/v1"
  export N8N_API_URL
fi

# --- F-03 (2026-07-25 stress-test fix): PERSONAL-DATA scan on the STAGED paths, the sibling of the
#     gitleaks scan above. gitleaks catches SECRETS; this catches personal DATA (other people's names,
#     kr/SEK figures, health values, phone numbers, secret file LOCATIONS) - the class that put four
#     real files on the public repo on 2026-07-20 and was only guarded by a MONTHLY sweep, i.e. up to
#     ~30 days of public exposure after a single bad commit. Fail policy mirrors gitleaks: a HIT blocks
#     (fail-closed on the result), a scanner that cannot run blocks too (exit 1) EXCEPT when node is
#     absent, which is handled above. The monthly S9 sweep remains the level-triggered backstop.
"$NODE" "$ROOT/scripts/personal-data-scan.js" --staged
PDS=$?
if [ "$PDS" -eq 2 ]; then
  echo "pre-commit: BLOCKED - personal data in the STAGED content (listed above)." >&2
  echo "pre-commit: this repo is PUBLIC. Unstage it, gitignore it, or add a reviewed exception to system/personal-data-allowlist.json." >&2
  exit 1
elif [ "$PDS" -ne 0 ]; then
  echo "pre-commit: BLOCKED - personal-data scan errored (exit $PDS); fail-closed (cannot certify the commit is personal-data-free)." >&2
  echo "pre-commit: fix the scanner, or 'git commit --no-verify' to override deliberately." >&2
  exit 1
fi

echo "pre-commit: validate-alex (full suite, context=pre-commit; V10 = NEVER-TOUCH guard, V11 = forced-add guard on the staged changeset, V12 = trifecta gate, V13 = local wrapper model-pin contract). The validator prints its own suite range - this hook deliberately does not restate it (F-10)."
"$NODE" "$ROOT/scripts/validate-alex.js" --context=pre-commit --changed
STATUS=$?
if [ $STATUS -ne 0 ]; then
  echo "pre-commit: BLOCKED - validation failed (see FAILED lines above)." >&2
  echo "pre-commit: fix the named drift (usually: edit the source, run 'node scripts/generate-alex.js')." >&2
  exit $STATUS
fi
exit 0
