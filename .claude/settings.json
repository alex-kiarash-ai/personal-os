{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(shasum *)",
      "Bash(awk *)",
      "Bash(cut *)",
      "Bash(wc *)",
      "Bash(mv *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(source *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials-ledger.json)",
      "Read(**/*.tar.gpg)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(nc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$ALEX_UNTRUSTED_LANE\" ]; then node \"${CLAUDE_PROJECT_DIR:-.}/scripts/untrusted-lane-guard.js\"; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/capture-typed-input.js\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/system/recall/recall-inject.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PD=\"${CLAUDE_PROJECT_DIR:-.}\"; if [ -f \"$PD/work/voice/.venv/Scripts/python.exe\" ]; then \"$PD/work/voice/.venv/Scripts/python.exe\" \"$PD/work/voice/v3/speak_hook.py\"; else echo '{\"systemMessage\":\"VOICE HOOK DOWN: work/voice/.venv missing or broken - speech out is dead until rebuilt (work/voice/README.md)\"}'; mkdir -p \"$PD/outputs/logs\"; echo \"$(date '+%Y-%m-%d %H:%M') speak_hook: venv python missing\" >> \"$PD/outputs/logs/voice-hook-errors.log\"; fi"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PD=\"${CLAUDE_PROJECT_DIR:-.}\"; if [ -f \"$PD/work/voice/.venv/Scripts/python.exe\" ]; then \"$PD/work/voice/.venv/Scripts/python.exe\" \"$PD/work/voice/v3/notify_hook.py\"; else echo '{\"systemMessage\":\"VOICE HOOK DOWN: work/voice/.venv missing or broken - notifications are silent until rebuilt (work/voice/README.md)\"}'; mkdir -p \"$PD/outputs/logs\"; echo \"$(date '+%Y-%m-%d %H:%M') notify_hook: venv python missing\" >> \"$PD/outputs/logs/voice-hook-errors.log\"; fi"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/lifecycle.js\" precompact",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/lifecycle.js\" sessionend",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/lifecycle.js\" toolfail",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
